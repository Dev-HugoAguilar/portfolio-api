  "chunks": [
    {
      "chunk_id": "BM-2026-11-05-TASA",
      "source_id": "BM-2026-11-05",
      "heading": "Decisión sobre la tasa",
      "content": "El 5 de noviembre de 2026, la Junta de Gobierno redujo en 25 puntos base el objetivo de la tasa interbancaria a un día, a 6.25%. La medida entró en vigor el 6 de noviembre de 2026.",
      "keywords": [
        "tasa",
