# =============================================================================
# PORTAFOLIO HUGO AGUILAR — entorno local
# -----------------------------------------------------------------------------
# Copia este archivo como `.env` (en la raíz del proyecto) y cambia los valores.
# `.env` NO se versiona: está en .gitignore.
# =============================================================================

# --- MongoDB (docker compose) -------------------------------------------------
MONGO_ROOT_USER=portfolio_root
MONGO_ROOT_PASSWORD=cambia_esta_clave_root
MONGO_DB=hugo_portfolio

# Usuario de aplicación con permisos solo sobre MONGO_DB (lo crea deploy/mongo-init.js)
APP_DB_USER=portfolio_app
APP_DB_PASSWORD=cambia_esta_clave_app

# Puerto del host para el MongoDB de Compose. Se usa 27018 para no chocar con un
# MongoDB local que ya escuche en 27017.
MONGO_HOST_PORT=27018

# Puerto del host para la API. Se usa 8001 para dejar libre el 8000 del sitio
# estático; cámbialo si otro proyecto ya ocupa el 8001.
BACKEND_HOST_PORT=8001

# --- Backend ------------------------------------------------------------------
MONGODB_DB=hugo_portfolio

# URI que usa la API. La base que se usa es la de MONGODB_DB: el nombre dentro de
# la URI no se usa para elegir base. Dentro de docker compose la URI la define el
# propio compose apuntando al servicio `mongo`; esta variable solo se usa si
# ejecutas la API fuera de Docker (uvicorn en tu máquina).
#
#   Con el MongoDB de Compose (usuario de aplicación, puerto 27018):
#     MONGODB_URI=mongodb://portfolio_app:<APP_DB_PASSWORD>@127.0.0.1:27018/hugo_portfolio?authSource=hugo_portfolio
#   Con un MongoDB local sin autenticación (desarrollo):
#     MONGODB_URI=mongodb://127.0.0.1:27017/hugo_portfolio
MONGODB_URI=mongodb://127.0.0.1:27017/hugo_portfolio

# Orígenes permitidos por CORS (separados por comas). El sitio estático se sirve
# aparte, normalmente en el puerto 8000.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

# Nivel de log de uvicorn: critical | error | warning | info | debug
LOG_LEVEL=info

# --- Marketing y clientes (GA4 → MongoDB) ------------------------------------
#: Proyecto de Google Cloud SOLO para la extracción (BigQuery Sandbox); la API y
#: el tablero no lo usan: leen la versión publicada en MongoDB.
MARKETING_GCP_PROJECT=
#: Carpeta de la copia original de la extracción (fuera de Git).
# MARKETING_DATA_DIR=backend/data/marketing
#: Segundos de caché del backend por versión y filtros normalizados.
# MARKETING_CACHE_TTL_S=300
#: Base propia para las colecciones de este caso (por omisión, MONGODB_DB).
# MARKETING_MONGODB_DB=


# --- Atlas comercial · Demanda y ventas (Walmart M5) ------------------------
# Carpeta con los CSV de la competición (no se versionan).
# Destino exclusivo del proyecto: solo MongoDB LOCAL (mongodb+srv y hosts remotos se rechazan).
# COMERCIAL_MONGODB_URI=mongodb://127.0.0.1:27017/atlas_comercial_local
# COMERCIAL_MONGODB_DB=atlas_comercial_local
# Carpeta con los CSV de la competición (no se versionan).
# COMERCIAL_DATA_DIR=D:/Portafolio/Portafolio_Hugo_Aguilar/backend/data/m5
# Caché del backend por versión y filtros (segundos).
# COMERCIAL_CACHE_TTL_S=120
# Ventanas de backtesting del baseline.
# COMERCIAL_VENTANAS=6

# --- Briefing con evidencia · Banco de México (RAG léxico) -------------------
# La colección es dedicada; no reutiliza MONGODB_DB ni otras colecciones.
# RAG_BANXICO_MONGODB_DB=portfolio_demos
# RAG_BANXICO_COLLECTION=rag_banxico_chunks
# Proveedor opcional compatible con OpenAI. Si falta una de las tres, la
# respuesta es extractiva y se etiqueta como tal.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# --- Copiloto NL-to-SQL · indicadores WDI de México --------------------------
# SQLite se genera desde dashboards/copiloto-nl-sql/runtime/data.json.
# NL_SQL_DB_PATH=backend/data/copiloto_nl_sql/wdi.sqlite3
# La auditoría reutiliza MONGODB_URI y solo guarda metadatos, nunca la pregunta.
# NL_SQL_AUDIT_ENABLED=true
# NL_SQL_AUDIT_DB=portfolio_demos
# NL_SQL_AUDIT_COLLECTION=nl_sql_query_audit
